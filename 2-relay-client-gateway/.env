# Local bind address and port for the Relay Client Gateway
RELAY_HOST=127.0.0.1
RELAY_PORT=18802

# Local WAA Proof Server URL (3-waa-proof-server)
PROOF_SERVER_URL=https://waa.spinsnow.fun

# Optional API key for downstream OpenAI / Gemini clients (leave empty to disable check)
RELAY_API_KEY=sk-waa-local-relay-key

# Default model when not specified by client
DEFAULT_MODEL=gemini-3.8-flash

# Cookie credential directory (one JSON per account; relative to project root)
COOKIES_DIR=./cookies
